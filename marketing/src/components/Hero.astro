---
import { Image } from "astro:assets";
import { APP_HOST, SIGN_UP_URL } from "../lib/constants";
import dashboardDesktop from "../assets/hero-dashboard.webp";
import dashboardMobile from "../assets/hero-dashboard-mobile.webp";

const headlines = [
  ["Know why you're", "actually ", "winning."],
  ["Find the setups", "that actually ", "pay."],
  ["Stop repeating", "the same ", "mistakes."],
  ["Trade your rules,", "not your ", "mood."],
  ["Spot tilt early.", "Protect your ", "edge."],
];
---

<section class="hero mx-auto max-w-6xl px-6 pb-24 pt-20 sm:pb-32 sm:pt-28">
  <div class="reveal mx-auto max-w-3xl text-center">
    <p class="text-[11px] font-semibold uppercase tracking-widest text-text-faint">
      For forex &amp; crypto traders
    </p>
    <h1 class="mt-5 text-[36px] font-black leading-[1.05] tracking-tightest text-text sm:text-[64px]">
      <span class="sr-only">Know why you're actually winning.</span>
      <span class="rotator" id="headline-rotator" aria-hidden="true">
        {
          headlines.map((headline, i) => (
            <span class={`rotator-item ${i === 0 ? "is-active" : ""}`}>
              <span class="rotator-line">{headline[0]}</span>
              <span class="rotator-line">
                {headline[1]}
                <span class="text-signal-red">{headline[2]}</span>
              </span>
            </span>
          ))
        }
      </span>
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-[17px] leading-relaxed text-text-muted">
      A trade journal for forex and crypto. It works out your P&amp;L
      properly, shows which setups and rules actually pay, and keeps you
      inside the limits you set.
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
      <a
        href={SIGN_UP_URL}
        class="rounded-lg bg-signal-red px-6 py-3 text-[14px] font-semibold text-white transition-opacity hover:opacity-90"
      >
        Start journaling free
      </a>
      <a
        href="#how-it-works"
        class="text-[13px] font-medium text-text-muted underline underline-offset-4 transition-colors hover:text-text"
      >
        See how it works
      </a>
    </div>
  </div>

  <div class="showcase reveal relative mx-auto mt-16 max-w-5xl sm:mt-20">
    <div class="showcase-glow" aria-hidden="true"></div>

    <div class="showcase-stage relative">
      <!-- Desktop: browser window -->
      <div class="browser hidden overflow-hidden rounded-xl border border-line bg-bg-1 md:block">
        <div class="flex items-center gap-3 border-b border-line bg-bg-0/70 px-4 py-3">
          <div class="flex gap-1.5" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-text-faint/40"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-text-faint/40"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-text-faint/40"></span>
          </div>
          <div class="mx-auto flex w-full max-w-sm items-center justify-center gap-1.5 rounded-md bg-bg-0 px-3 py-1 text-[11px] text-text-faint">
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <rect x="1.5" y="4.5" width="7" height="4.5" rx="1" stroke="currentColor" />
              <path d="M3 4.5V3a2 2 0 0 1 4 0v1.5" stroke="currentColor" />
            </svg>
            {APP_HOST}/dashboard
          </div>
          <div class="w-[42px]" aria-hidden="true"></div>
        </div>
        <Image
          src={dashboardDesktop}
          alt="Marked dashboard showing net P&L, win rate, profit factor, today's limits and an equity curve"
          width={1100}
          height={760}
          widths={[800, 1100, 1600]}
          sizes="(min-width: 1024px) 1024px, 100vw"
          loading="eager"
          class="block h-auto w-full"
        />
      </div>

      <!-- Phone: alone on small screens, overlapping the browser on wide ones -->
      <div class="phone mx-auto w-[230px] md:absolute md:bottom-0 md:right-[3%] md:mx-0 md:w-[22%] md:min-w-[190px]">
        <div class="overflow-hidden rounded-[2rem] border-[5px] border-[#1c1c20] bg-bg-0 shadow-[0_0_0_1px_rgba(255,255,255,0.08),0_30px_60px_-15px_rgba(0,0,0,0.8)]">
          <Image
            src={dashboardMobile}
            alt="Marked dashboard on a phone"
            width={780}
            height={1688}
            widths={[390, 780]}
            sizes="(min-width: 768px) 22vw, 230px"
            loading="eager"
            class="block h-auto w-full"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow-x: clip;
  }
  .rotator {
    display: grid;
  }
  .rotator-item {
    grid-area: 1 / 1;
    display: block;
    pointer-events: none;
  }
  .rotator-line {
    display: block;
    opacity: 0;
    transform: translateY(0.45em);
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .rotator-line:nth-child(2) {
    transition-delay: 0.09s;
  }
  .rotator-item.is-active {
    pointer-events: auto;
  }
  .rotator-item.is-active .rotator-line {
    opacity: 1;
    transform: none;
    transition-delay: 0.35s;
  }
  .rotator-item.is-active .rotator-line:nth-child(2) {
    transition-delay: 0.45s;
  }
  .rotator-item.is-leaving .rotator-line {
    opacity: 0;
    transform: translateY(-0.35em);
    transition-delay: 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .rotator-line {
      transition: none;
    }
  }

  .showcase-glow {
    position: absolute;
    inset: -8% -4% 10%;
    background:
      radial-gradient(45% 55% at 30% 40%, rgba(60, 179, 113, 0.16), transparent 70%),
      radial-gradient(40% 50% at 75% 55%, rgba(229, 83, 66, 0.14), transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }
  .browser {
    box-shadow:
      0 1px 0 0 rgba(255, 255, 255, 0.05) inset,
      0 40px 80px -30px rgba(0, 0, 0, 0.8);
  }
  .showcase-stage {
    -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 78%, transparent 100%);
  }
  @media (min-width: 768px) {
    .showcase-stage {
      padding-bottom: 1.5rem;
      -webkit-mask-image: linear-gradient(to bottom, #000 85%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 85%, transparent 100%);
    }
  }
</style>


<script>
  const rotator = document.getElementById("headline-rotator");
  const items = rotator ? Array.from(rotator.querySelectorAll<HTMLElement>(".rotator-item")) : [];
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (rotator && items.length > 1 && !reduce) {
    let current = 0;
    let timer: number | undefined;

    const next = () => {
      const leaving = items[current];
      current = (current + 1) % items.length;
      leaving?.classList.remove("is-active");
      leaving?.classList.add("is-leaving");
      items[current]?.classList.remove("is-leaving");
      items[current]?.classList.add("is-active");
      // Reset the old one once it has faded, so it can rise in again later.
      window.setTimeout(() => leaving?.classList.remove("is-leaving"), 700);
    };

    const start = () => {
      if (timer === undefined) timer = window.setInterval(next, 7000);
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };

    start();
    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
  }
</script>