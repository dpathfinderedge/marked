---
const features = [
  {
    title: "Real P&L math",
    body: "Direct, converted, and manual pricing paths for forex — including a live rate lookup for true cross pairs — plus straightforward crypto math.",
  },
  {
    title: "Equity curve & breakdowns",
    body: "Win rate, profit factor, average R, and cumulative P&L, broken down by pair, session, and setup tag.",
  },
  {
    title: "The consecutive-loss flag",
    body: "Set your own threshold. Trades that follow a losing streak get marked automatically, in the ledger and on the dashboard.",
  },
  {
    title: "Installable, offline-aware",
    body: "A real installable app on desktop and mobile — not just a bookmarked tab — with clear offline handling instead of silently failed writes.",
  },
];
---

<section id="features" class="border-t border-line py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal">
      <p class="text-[11px] font-semibold uppercase tracking-widest text-signal-red">
        Features
      </p>
      <h2 class="mt-3 max-w-md text-[28px] font-bold leading-tight tracking-tight text-text sm:text-[34px]">
        Everything to find your edge. Nothing you don't need.
      </h2>
    </div>

    <div class="mt-16 grid gap-4 sm:grid-cols-2">
      {
        features.map((feature, i) => (
          <div
            class="reveal rounded-xl border border-line bg-bg-1 p-6 transition-colors hover:border-line-strong"
            style={`transition-delay: ${i * 70}ms`}
          >
            <h3 class="text-[15px] font-semibold text-text">{feature.title}</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-text-muted">
              {feature.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>