---
import Icon from "./Icon.astro";

const steps = [
  {
    number: 1,
    icon: "pencil",
    title: "Log a trade",
    body: "Pair, direction, entry and exit, size, session, setup tag. Tick your checklist first, or import your MetaTrader history in one go.",
    chips: ["Checklist", "Setup tags", "MT4 / MT5 import"],
  },
  {
    number: 2,
    icon: "calculator",
    title: "The math happens for you",
    body: "Real pip and contract-size math for forex, real price × quantity math for crypto. Not a rough estimate.",
    chips: ["Forex pips", "Crypto P&L", "Live FX rates"],
  },
  {
    number: 3,
    icon: "trend",
    title: "See your actual edge",
    body: "Win rate, profit factor, equity curve and Insights on which setups and rules pay, plus a flag when you're on a losing streak.",
    chips: ["Equity curve", "Insights", "Loss-streak flag"],
  },
];
---

<section id="how-it-works" class="border-t border-line py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal">
      <p class="text-[11px] font-semibold uppercase tracking-widest text-signal-red">
        Process
      </p>
      <h2 class="mt-3 max-w-md text-[28px] font-bold leading-tight tracking-tight text-text sm:text-[34px]">
        From scattered trades to a real edge.
      </h2>
    </div>

    <div class="relative mt-16" data-stagger>
      <div
        class="absolute left-[16.7%] right-[16.7%] top-[27px] hidden h-px md:block"
        aria-hidden="true"
      >
        <div class="reveal step-line h-full w-full" data-reveal="line"></div>
      </div>

      <ol class="grid gap-5 md:grid-cols-3 md:gap-6">
        {
          steps.map((step) => (
            <li class="reveal" data-reveal="rise">
              <div class="group relative h-full rounded-2xl border border-line bg-bg-1 p-6 pt-0 transition-colors duration-300 hover:border-line-strong md:border-transparent md:bg-transparent md:p-0 md:hover:border-transparent">
                <div class="relative -mt-0 flex items-center gap-4 pt-6 md:justify-center md:pt-0">
                  <span class="relative z-10 flex h-[54px] w-[54px] items-center justify-center rounded-2xl border border-line-strong bg-bg-1 text-signal-red md:shadow-[0_0_0_6px_rgb(var(--bg-0))] transition-colors duration-300 group-hover:border-signal-red/50 group-hover:bg-signal-red/10">
                    <Icon name={step.icon} class="h-6 w-6" />
                  </span>
                  <span class="font-mono text-[12px] text-text-faint md:hidden">
                    Step {step.number}
                  </span>
                </div>

                <div class="md:mt-8 md:rounded-2xl md:border md:border-line md:bg-bg-1 md:p-6 md:transition-colors md:duration-300 md:group-hover:border-line-strong">
                  <p class="hidden font-mono text-[12px] text-text-faint md:block">
                    Step {step.number}
                  </p>
                  <h3 class="mt-4 text-[17px] font-semibold tracking-tight text-text md:mt-2">
                    {step.title}
                  </h3>
                  <p class="mt-2 text-[14px] leading-relaxed text-text-muted">
                    {step.body}
                  </p>
                  <ul class="mt-5 flex flex-wrap gap-2">
                    {step.chips.map((chip) => (
                      <li class="rounded-full border border-line bg-bg-0 px-2.5 py-1 text-[12px] text-text-muted">
                        {chip}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>