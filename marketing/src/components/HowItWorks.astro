---
const steps = [
  {
    number: "01",
    title: "Log a trade",
    body: "Pair, direction, entry/exit, size, session, setup tag. Takes seconds.",
  },
  {
    number: "02",
    title: "The math happens for you",
    body: "Real pip and contract-size math for forex, real price × quantity math for crypto — not a rough estimate.",
  },
  {
    number: "03",
    title: "See your actual edge",
    body: "Win rate, profit factor, avg R, equity curve, and breakdowns by pair, session, and setup — plus a flag when you're on a losing streak.",
  },
];
---

<section id="how-it-works" class="border-t border-line py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal">
      <p class="text-[11px] font-semibold uppercase tracking-widest text-signal-red">
        Process
      </p>
      <h2 class="mt-3 max-w-md text-[28px] font-bold leading-tight tracking-tight text-text sm:text-[34px]">
        From scattered trades to a real edge.
      </h2>
    </div>

    <div class="mt-16 grid gap-10 sm:grid-cols-3 sm:gap-8">
      {
        steps.map((step, i) => (
          <div class="reveal" style={`transition-delay: ${i * 90}ms`}>
            <p class="font-mono text-[12px] text-signal-red">{step.number}</p>
            <h3 class="mt-3 text-[16px] font-semibold text-text">{step.title}</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-text-muted">
              {step.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>