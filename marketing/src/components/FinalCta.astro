---
import { APP_URL } from "../lib/constants";
---

<section class="border-t border-rule bg-surface py-20">
  <div class="mx-auto max-w-2xl px-6 text-center">
    <h2 class="font-display text-3xl italic text-ink">
      Start your next trade with a real edge.
    </h2>
    <p class="mt-3 font-sans text-sm text-muted">
      Free to start. No credit card.
    </p>
    <a
      href={APP_URL}
      class="mt-8 inline-block rounded-lg bg-stamp px-6 py-3 font-sans text-sm font-medium text-paper transition-opacity hover:opacity-90"
    >
      Start journaling free
    </a>
  </div>
</section>