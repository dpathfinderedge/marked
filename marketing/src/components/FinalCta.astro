---
import { APP_URL } from "../lib/constants";
---

<section class="border-t border-line py-24 sm:py-32">
  <div class="reveal mx-auto max-w-xl px-6 text-center">
    <p class="text-[11px] font-semibold uppercase tracking-widest text-signal-red">
      Get started
    </p>
    <h2 class="mt-3 text-[28px] font-bold leading-tight tracking-tight text-text sm:text-[34px]">
      Start your next trade with a real edge.
    </h2>
    <p class="mt-3 text-[14px] text-text-muted">Free to start. No credit card.</p>
    <a
      href={APP_URL}
      class="mt-8 inline-block rounded-lg bg-signal-red px-6 py-3 text-[14px] font-semibold text-white transition-opacity hover:opacity-90"
    >
      Start journaling free
    </a>
  </div>
</section>