---
import { APP_URL } from "../lib/constants";
---

<header class="sticky top-0 z-50 border-b border-line/60 bg-bg-0/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-2.5">
      <svg
        width="22"
        height="22"
        viewBox="0 0 36 36"
        fill="none"
        style="transform: rotate(-9deg)"
        aria-hidden="true"
      >
        <circle cx="18" cy="18" r="15.5" stroke="currentColor" stroke-width="2.5" class="text-signal-red" />
        <circle cx="18" cy="18" r="11" stroke="currentColor" stroke-width="1" opacity="0.5" class="text-signal-red" />
        <path
          d="M12 19L16 23L25 12"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-signal-red"
        />
      </svg>
      <span class="text-[15px] font-semibold tracking-tight text-text">Marked</span>
    </a>

    <nav class="hidden items-center gap-8 text-[13px] font-medium text-text-muted sm:flex">
      <a href="/#how-it-works" class="transition-colors hover:text-text">How it works</a>
      <a href="/#features" class="transition-colors hover:text-text">Features</a>
      <a href="/#pricing" class="transition-colors hover:text-text">Pricing</a>
      <a href="/#faq" class="transition-colors hover:text-text">FAQ</a>
    </nav>

    <div class="hidden items-center gap-5 sm:flex">
      <a
        href={APP_URL}
        class="text-[13px] font-medium text-text-muted transition-colors hover:text-text"
      >
        Sign in
      </a>
      <a
        href={APP_URL}
        class="rounded-lg bg-signal-red px-4 py-2 text-[13px] font-semibold text-white transition-opacity hover:opacity-90"
      >
        Start free
      </a>
    </div>

    <button
      type="button"
      id="mobile-menu-button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="relative flex h-9 w-9 items-center justify-center rounded-lg text-text transition-colors hover:bg-bg-1 sm:hidden"
    >
      <svg id="icon-menu" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 5H17M3 10H17M3 15H17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <svg id="icon-close" width="20" height="20" viewBox="0 0 20 20" fill="none" class="hidden" aria-hidden="true">
        <path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
      <span class="sr-only">Toggle menu</span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu sm:hidden" aria-hidden="true" inert>
    <div class="mobile-menu-inner">
      <div class="flex flex-col gap-1 border-t border-line/60 px-6 py-4">
        <a
          href="/#how-it-works"
          class="rounded-lg px-3 py-2.5 text-[14px] font-medium text-text-muted transition-colors hover:bg-bg-1 hover:text-text"
        >
          How it works
        </a>
        <a
          href="/#features"
          class="rounded-lg px-3 py-2.5 text-[14px] font-medium text-text-muted transition-colors hover:bg-bg-1 hover:text-text"
        >
          Features
        </a>
        <a
          href="/#pricing"
          class="rounded-lg px-3 py-2.5 text-[14px] font-medium text-text-muted transition-colors hover:bg-bg-1 hover:text-text"
        >
          Pricing
        </a>
        <a
          href="/#faq"
          class="rounded-lg px-3 py-2.5 text-[14px] font-medium text-text-muted transition-colors hover:bg-bg-1 hover:text-text"
        >
          FAQ
        </a>
        <div class="mt-2 flex flex-col gap-2 border-t border-line/60 pt-4">
          <a
            href={APP_URL}
            class="rounded-lg px-3 py-2.5 text-center text-[14px] font-medium text-text-muted transition-colors hover:bg-bg-1 hover:text-text"
          >
            Sign in
          </a>
          <a
            href={APP_URL}
            class="rounded-lg bg-signal-red px-3 py-2.5 text-center text-[14px] font-semibold text-white transition-opacity hover:opacity-90"
          >
            Start free
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .mobile-menu {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows 280ms cubic-bezier(0.32, 0.72, 0, 1),
      opacity 200ms ease,
      visibility 0s linear 280ms;
  }
  .mobile-menu[data-open="true"] {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    transition:
      grid-template-rows 280ms cubic-bezier(0.32, 0.72, 0, 1),
      opacity 240ms ease 40ms,
      visibility 0s;
  }
  .mobile-menu-inner {
    overflow: hidden;
    min-height: 0;
  }
  .mobile-menu-inner > div {
    transform: translateY(-6px);
    transition: transform 280ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .mobile-menu[data-open="true"] .mobile-menu-inner > div {
    transform: translateY(0);
  }
  #mobile-menu-button svg {
    transition:
      opacity 160ms ease,
      transform 220ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mobile-menu[data-open="true"],
    .mobile-menu-inner > div,
    #mobile-menu-button svg {
      transition: none;
    }
  }
</style>

<script>
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const iconMenu = document.getElementById("icon-menu");
  const iconClose = document.getElementById("icon-close");

  function setOpen(open: boolean): void {
    if (!menu) return;
    menu.dataset.open = String(open);
    menu.setAttribute("aria-hidden", String(!open));
    menu.toggleAttribute("inert", !open);
    button?.setAttribute("aria-expanded", String(open));
    if (iconMenu) {
      iconMenu.style.opacity = open ? "0" : "1";
      iconMenu.style.transform = open ? "rotate(-90deg)" : "rotate(0)";
    }
    if (iconClose) {
      iconClose.style.opacity = open ? "1" : "0";
      iconClose.style.transform = open ? "rotate(0)" : "rotate(90deg)";
    }
  }

  if (iconMenu && iconClose) {
    iconClose.classList.remove("hidden");
    iconClose.style.position = "absolute";
    setOpen(false);
  }

  button?.addEventListener("click", () => {
    setOpen(menu?.dataset.open !== "true");
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  window.matchMedia("(min-width: 640px)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });
</script>