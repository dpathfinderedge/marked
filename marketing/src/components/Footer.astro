---
import { APP_URL } from "../lib/constants";

const columns = [
  {
    title: "Product",
    links: [
      { label: "How it works", href: "/#how-it-works" },
      { label: "Features", href: "/#features" },
      { label: "Pricing", href: "/#pricing" },
      { label: "FAQ", href: "/#faq" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Privacy policy", href: "/privacy" },
      { label: "Terms of service", href: "/terms" },
      { label: "Refund policy", href: "/refunds" },
    ],
  },
  {
    title: "App",
    links: [
      { label: "Sign in", href: APP_URL },
      { label: "Start free", href: APP_URL },
    ],
  },
];
---

<footer class="border-t border-line py-12">
  <div class="mx-auto flex max-w-6xl flex-col gap-10 px-6 sm:flex-row sm:justify-between">
    <div>
      <p class="text-[15px] font-semibold tracking-tight text-text">Marked</p>
      <p class="mt-2 max-w-xs text-[13px] leading-relaxed text-text-muted">
        A trade journal for forex and crypto traders.
      </p>
    </div>

    <nav aria-label="Footer" class="grid grid-cols-2 gap-8 sm:grid-cols-3 sm:gap-16">
      {
        columns.map((column) => (
          <div>
            <p class="text-[11px] font-semibold uppercase tracking-widest text-text-faint">
              {column.title}
            </p>
            <ul class="mt-3 flex flex-col gap-2">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="text-[13px] text-text-muted transition-colors hover:text-text">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="mx-auto mt-10 max-w-6xl px-6">
    <p class="font-mono text-[11px] text-text-faint">
      &copy; {new Date().getFullYear()} Marked. Marked is a journaling tool, not financial advice.
    </p>
  </div>
</footer>